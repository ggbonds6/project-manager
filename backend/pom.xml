<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.pmgt</groupId>
    <artifactId>project-manager-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>project-manager-backend</name>
    <description>政府信息化项目管理系统 - 后端服务</description>

    <properties>
        <java.version>17</java.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          reactive-streams：Spring 6 的 RestClient / ReactiveAdapterRegistry 在【运行期】需要它。
          缺了会在真发 HTTP 时报 NoClassDefFoundError（线上 v3.6.5 故障：手动点击「附件解析」报 500
          「系统繁忙」，日志为 Handler dispatch failed: java.lang.NoClassDefFoundError:
          org/reactivestreams/Publisher，Caused by: ClassNotFoundException: org.reactivestreams.Publisher；
          自动解析也因此从不产生 attachment_ai_task 记录）。

          触发点具体是 multipart 上传路径：org.springframework.http.client.MultipartBodyBuilder
          自身引用了 org/reactivestreams/Publisher（asyncPart / PublisherPartBuilder 那条 Flux 分支），
          JVM 链接该类时就要解析这个类型。本项目只有 spring-boot-starter-web（servlet 栈，不带 webflux/reactor），
          没有任何依赖把 reactive-streams 传进来，于是 multipart POST 一调用就崩。

          ⚠️ 为什么单测全绿却线上炸：MockRestServiceServer 用假的 request factory 顶掉了真实发送，
          而 AiServiceClientTest 又【从来没有覆盖 submitParse（multipart）这条路径】，
          所以这个「只有真发请求才会被链接到」的缺失依赖一直躲过了测试。
          回归测试见 RestClientReactiveStreamsTest（JDK HttpServer 起真 socket + 真 RestClient）。

          版本不写死：由 spring-boot-starter-parent（Spring Boot BOM）统一管理，
          避免和 Spring Framework 的版本漂移。
        -->
        <dependency>
            <groupId>org.reactivestreams</groupId>
            <artifactId>reactive-streams</artifactId>
        </dependency>

        <!-- MyBatis-Plus (Spring Boot 3) -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- 崖山 YashanDB JDBC 驱动（无 Maven 坐标，本地 lib 引入；接入内网 Nexus 后可改普通依赖） -->
        <dependency>
            <groupId>com.yashandb</groupId>
            <artifactId>yashandb-jdbc</artifactId>
            <version>1.9.3</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/yashandb-jdbc-1.9.3.jar</systemPath>
        </dependency>

        <!-- 华为 OBS 附件对象存储（S3 兼容；pathStyle + 忽略证书校验，见 application.yml app.storage） -->
        <dependency>
            <groupId>com.huaweicloud</groupId>
            <artifactId>esdk-obs-java</artifactId>
            <version>3.24.3</version>
        </dependency>

        <!-- JWT 认证（M2 使用） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- 仅用 BCrypt 做密码哈希，不引入完整 Spring Security 过滤链 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <includeSystemScope>true</includeSystemScope>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
