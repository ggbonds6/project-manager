# 复制为 .env 后按需修改；docker compose 会自动读取
# ⚠️ 必须放在【本文件同目录】（deploy/docker/），compose v2 只从 compose 文件所在目录读 .env；
#    放在仓库根不会生效（会静默回落到默认值）。
# ============================================================
# 崖山 YashanDB（Oracle 模式）主备集群（外部主机，非容器）
# ============================================================
# 镜像版本：与 docker load 进来的镜像 tag 一致（离线部署时用，见部署与发布全流程手册 §3/.env）
IMAGE_TAG=latest
YASHAN_MASTER_IP=10.254.212.106
YASHAN_STANDBY_IP=10.254.212.107
# YASHAN_DB = 崖山 Oracle 模式下的 schema 名（生产为 PM，大写；勿写成 project_manager）
YASHAN_DB=PM
# ★账号固定为业务账号 pm【不要改成 sys 等管理账号】，本地与服务器统一：
#   ① Oracle 模式下应用按"登录用户所在 schema"查表；用 sys 会去 SYS 下找表 → 报表不存在/建错表；
#   ② sys 与 pm 口令不同，混用极易配错 → 见下面"口令不匹配"的连锁反应
YASHAN_USER=pm
# ★口令：填 pm 用户的实际密码（本文件是模板，口令留空；真实值只写进同目录的 .env，
#   .env 已被 .gitignore 排除，**禁止把明文口令提交进仓库/文档/脚本**）。
#   含 @ ! 等特殊字符无需转义，直接填写即可（compose 负责注入）。
YASHAN_PASSWORD=
# ⚠️ 口令与账号不匹配会引发连锁故障，两个错误码要分清：
#   YAS-02143 invalid username/password → 口令不对（账号没锁），改对即可，无需 DBA
#   YAS-02193 the account is locked    → 账号被锁（容器反复重试触发），口令再对也连不上，需 DBA 解锁
#   典型链路：口令填错 → 每几秒重试 → 报 YAS-02143 → 连续失败触发锁定 → 日志变成 YAS-02193。
#   所以看到 YAS-02193，先怀疑口令填错；改口令前务必先 docker compose stop 止血。

# 后端
JWT_SECRET=please-change-this-jwt-secret-in-production-0123456789
# 附件存储（v1.1 起支持对象存储）：
#   local（默认，本地卷/共享盘，配 UPLOAD_VOLUME）| obs（华为 OBS，S3 兼容、path-style、忽略证书校验）
APP_STORAGE_TYPE=local
APP_STORAGE_OBS_ENDPOINT=https://obs.lhim.com
APP_STORAGE_OBS_BUCKET=pdmsbucket
APP_STORAGE_OBS_AK=
APP_STORAGE_OBS_SK=
# 附件对象在桶内前缀目录（本项目结构：uploads/2026/...，与本地 uploads 一致；桶根直存可置空）
APP_STORAGE_OBS_PREFIX=uploads
# 附件存储：留空=本地命名卷 pm_uploads（单机默认）；
# 双机 + 负载均衡且用 local 时必须填共享目录绝对路径（NFS/共享盘，两机指向同一存储）：
# UPLOAD_VOLUME=/mnt/pm-uploads
UPLOAD_VOLUME=

# 前端对外端口（宿主机）
WEB_PORT=8080

# ============================================================
# AI 能力服务（ai-backend，v3.6.0 起接入；**独立部署、独立发版**，不在本发布包的镜像里）
# ============================================================
# 主系统只代理它：浏览器永不直连 8100，权限与作用域都在主系统收口
# （见 docs/AI前端与集成方案.md §4.3、部署手册 §8）。
# 本组变量只有 pm-backend 用得到；不改这三行也能启动，但 AI 功能会不可用。
#
# ① 总开关：false = 彻底关闭 AI 入口（/api/ai/* 返回明确业务错误，界面上直说"AI 服务不可用"）
AI_ENABLED=true
#
# ② ★AI 服务地址：必须填【从 pm-backend 容器里】能访问到的地址
#    · AI 与主系统在【同一台宿主机】：用 host.docker.internal（编排里已把该名字映射到宿主机）
#    · AI 在【另一台机器】：填那台机器的内网 IP，例如 http://10.254.208.40:8100
#      ⚠️ 双机负载均衡时推荐"AI 集中一台"：AI 的文档库/向量缓存是本地文件，
#         两台各自跑一个会让两个索引各自演化，同一个问题问到不同机器答案不一致。
#    · ⚠️ 绝不能填 127.0.0.1：在容器里那是 pm-backend 自己，必然连不上（这是最常见的配错）
AI_SERVICE_BASE_URL=http://host.docker.internal:8100
#
# ③ 服务间令牌（可选）：AI 服务当前**没有入站鉴权**，填了也只是发出去、对方不校验；
#    留空则连 Authorization 头都不发。真正的防护目前靠网络隔离（AI 端口别对全网开放）。
AI_SERVICE_TOKEN=
#
# ④ 上传附件后是否自动送 AI 解析：
#    ★首次部署建议保持 false —— 先把 AI 服务部署起来，在「AI 与知识库 → 服务自检」页确认可达，再改成 true。
#    若这里是 true 而 AI 不可用：上传本身仍会成功（附件照常入库），但附件会被标成
#    "解析失败（AI 服务不可用）"，日志里也会每次报一条 —— 不是故障，但会干扰判断。
AI_AUTO_PARSE=false
#
# ⑤ ★超时（秒）——四个值构成一条链，改任何一个都要回头看这条不变式：
#      scope_token ≥ 主系统→AI ≥ 前端，且【四者都不超过 nginx】
#    ┌ 前端问答超时       180s（前端已放宽）
#    ├ nginx proxy_read_timeout 300s（frontend-nginx.conf）
#    ├ 主系统→AI AI_CHAT_TIMEOUT 180s ← 本项（原为 60，长问答在这一跳被掐断＝用户报的"容易超时"）
#    └ scope_token 有效期  300s（见下面 ⑦）
#    为什么不能超过 nginx：超时会先被网关变成 504，用户看到"网关错误"而不是「AI 服务不可用」，
#    排障方向直接跑偏。所以 AI_CHAT_TIMEOUT 保持 180（≤300），不要再往上加。
AI_CHAT_TIMEOUT=180
# 其它接口（健康探测/文档列表/任务轮询/触发解析）必须快速失败，不要跟着放大：
AI_TIMEOUT=10
#
# ⑥ ★P2 受控查询回调地址（§11.2 的 biz_query.url）：**必须是从 AI 容器可达的主系统地址**。
#    它在主系统调 AI 的 /chat 时随请求下发，AI 侧需要业务事实（预算/合同/付款/附件数/统计）
#    时回调 PM_AI_QUERY_CALLBACK_URL/{entity}。
#    · 同宿主机（最常见）：http://host.docker.internal:<WEB_PORT>/api/ai/query
#      —— 注意端口用 WEB_PORT（对外只有 nginx），该地址走 nginx 的 /api/ 反代到 pm-backend:8080；
#         pm-backend 只在 compose 内网 expose 8080，AI 容器直接连 backend:8080 通常不通，故用 nginx 入口。
#    · AI 在另一台机器：填那台能访问到的主系统入口，例如 http://10.254.212.106:8080/api/ai/query
#      （即「AI 容器 → 主系统宿主机内网 IP:WEB_PORT」）。
#    · ⚠️ 绝不能填 127.0.0.1 —— 在 AI 容器里那是它自己；也别忘了端口要跟 WEB_PORT 一致。
#    · 留空 = 完全不启用受控查询：主系统不再下发 biz_query，AI 侧不注册 query_business_data 工具，
#      行为与本版本之前完全一致（可安全分批发版、便于回滚）。
PM_AI_QUERY_CALLBACK_URL=http://host.docker.internal:8080/api/ai/query
#
# ⑦ 作用域令牌有效期（秒）：主系统每次问答现签一枚 scope_token，只授权"该用户可访问的项目"。
#    ★ 它必须**大于一轮问答的最长耗时**，否则问答后段的业务数据回调会 401，
#      而模型会把"授权过期"说成"无权查看"甚至"系统里没有数据"——答案直接错。
#      同一套链：前端 180s ｜ nginx 300s ｜ 主系统→AI 180s ⇒ token 取 300s（= nginx 上限）。
#      上限写死在代码里（ScopeTokenService.MAX_TTL_SECONDS=300）：配大了会被夹回 300，
#      只能配小（配小会让长问答后段的系统查询失败）。
PM_AI_SCOPE_TOKEN_TTL_SECONDS=300
