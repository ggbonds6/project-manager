# 复制为 .env 后按需修改；docker compose 会自动读取
# ⚠️ 必须放在【本文件同目录】（deploy/docker/），compose v2 只从 compose 文件所在目录读 .env；
#    放在仓库根不会生效（会静默回落到默认值）。
# ============================================================
# 崖山 YashanDB（Oracle 模式）主备集群（外部主机，非容器）
# ============================================================
# 镜像版本：与 docker load 进来的镜像 tag 一致（离线部署时用，见部署与发布全流程手册 §3/.env）
IMAGE_TAG=latest
YASHAN_MASTER_IP=10.254.212.106
YASHAN_STANDBY_IP=10.254.212.107
# YASHAN_DB = 崖山 Oracle 模式下的 schema 名（生产为 PM，大写；勿写成 project_manager）
YASHAN_DB=PM
# ★账号必须是业务账号 pm，不要改成 sys 等管理账号：
#   ① 应用按"登录用户所在 schema"查表，用 sys 会在 SYS 下找表 → 报表不存在/建错表；
#   ② 账号与密码不匹配时容器会自动重启反复重试，连续失败触发数据库锁定 → YAS-02193 the account is locked
YASHAN_USER=pm
# 密码含 @ 等特殊字符时无需转义，直接填写即可（compose 负责注入）
YASHAN_PASSWORD=

# 后端
JWT_SECRET=please-change-this-jwt-secret-in-production-0123456789
# 附件存储（v1.1 起支持对象存储）：
#   local（默认，本地卷/共享盘，配 UPLOAD_VOLUME）| obs（华为 OBS，S3 兼容、path-style、忽略证书校验）
APP_STORAGE_TYPE=local
APP_STORAGE_OBS_ENDPOINT=https://obs.lhim.com
APP_STORAGE_OBS_BUCKET=pdmsbucket
APP_STORAGE_OBS_AK=
APP_STORAGE_OBS_SK=
# 附件对象在桶内前缀目录（本项目结构：uploads/2026/...，与本地 uploads 一致；桶根直存可置空）
APP_STORAGE_OBS_PREFIX=uploads
# 附件存储：留空=本地命名卷 pm_uploads（单机默认）；
# 双机 + 负载均衡且用 local 时必须填共享目录绝对路径（NFS/共享盘，两机指向同一存储）：
# UPLOAD_VOLUME=/mnt/pm-uploads
UPLOAD_VOLUME=

# 前端对外端口（宿主机）
WEB_PORT=8080
