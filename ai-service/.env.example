# ============================================================
# AI 服务配置模板
# 复制为 .env 后按实际环境填写：cp .env.example .env
# .env 不入库（见 .gitignore），密钥只写在本机。
# ============================================================

# ── 服务自身 ─────────────────────────────────────────────────
AI_HOST=0.0.0.0
AI_PORT=8100

# ── 大模型（千问，OpenAI 兼容接口）──────────────────────────
# 只要推理服务暴露 /v1/chat/completions 即可（vLLM / Ollama / 一体机均可）
# 常见形态：
#   vLLM        http://<ip>:8000/v1
#   Ollama      http://<ip>:11434/v1
#   厂商一体机   按厂商文档（注意结尾是否带 /v1）
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=在此填入密钥
# 模型名按推理服务实际暴露的名称填（用 vLLM 时通常就是部署时的 --served-model-name）
LLM_MODEL=qwen
LLM_TIMEOUT=300

# 单次送给模型的最大字符数（中文约 1 字 ≈ 1 token）。超出会**按页截断**，
# 并在提示词里明确告知模型"你没看到全部"，避免它把残缺当全文。
LLM_MAX_INPUT_CHARS=20000

# 输出上限。⚠️ Qwen3 等推理模型的**思维链会消耗大量输出额度**：
# 设小了会出现 `completion_tokens` 撞上限、`content` 为空（模型只思考没给答案）。
# 实测踩过：8192 时 6 页合同分析返回空内容。建议 ≥ 16384。
LLM_MAX_TOKENS=16384

# 是否保留思维链。**默认 false** —— 实测（同一份 6 页扫描件合同）：
#   开启思考 → 思考 30584 字、耗尽 16384 token、最终答案为空，耗时 4 分 55 秒；
#   关闭思考 → 完整产出全部章节，来源标注与置信度分档均正常。
# 结论：高约束抽取任务上，思考模式不但慢，还会把最终答案挤掉。
# 只有确实需要深度推理的任务（如合规性判断）才建议开启，且要同步调大 LLM_MAX_TOKENS。
LLM_ENABLE_THINKING=false

# ── OCR（**只有内网平台 OCR 一条路**，本地引擎已于 2026-09-18 移除）────
# 不再有 OCR_PROVIDER / OCR_DPI / OCR_WORKERS：识别固定走平台 PaddleOCR-VL
# （决策与实测依据见 README §13）。平台不可用时**报错并要求人工复核**，不降级。
# 平台 OCR 的地址与密钥：**默认复用上面的 LLM_*（同一个网关、同一个 sk）**，
# 只有想把 OCR 指到别的网关时才需要单独填这两项。
#OCR_BASE_URL=http://10.254.208.35:8090/v1
#OCR_API_KEY=sk-q38-xxxxxxxx
# 单次请求超时（秒）。大批量建议 600。
OCR_TIMEOUT=600
# 同时在飞的请求数。平台是本项目专用、可直接打满：
# 实测同一份 6 页合同：串行 1.84s/页 → 并发 6 得 1.33 页/秒 → 并发 12 得 2.45 页/秒（4.5×）。
OCR_CONCURRENCY=12
# 每个请求带几页（平台建议 ≤16 页/请求）
OCR_BATCH_PAGES=8
# 是否识别印章。**默认 false**，三个理由：
#   ① 印章块默认就返回（内容为空）＝免费的"这页有没有章"探测，不用开；
#   ② 开它会让含章文档吞吐约减半；
#   ③ 低 DPI 下会**编造**印章文字（实测 150DPI 图上读出过完全不相干的银行名）。
OCR_SEAL=false
# 印章裁剪图放大下限（平台侧参数，仅在 OCR_SEAL=true 时生效）。平台默认 400000。
# 印章裁剪图本身只有 ~330×330 像素，放大不足则笔画粘连读不出——它是印章识别**最有效的旋钮**。
# 确需印章文字建议按"两遍法"：先默认跑全量，再只对含章页用高 DPI + 本参数单独重跑。
OCR_SEAL_MIN_PIXELS=400000
# 发给平台 OCR 的图：150 DPI JPEG。
# 实测 120~300 DPI 的识别结果**完全一致**（模型内部下采样到 ≈100 万像素），
# 但 300DPI PNG 每页 6.7MB、150DPI JPEG 396KB —— 差 17 倍，白等的是上传时间。
OCR_PLATFORM_DPI=150
OCR_PLATFORM_FORMAT=jpeg
OCR_PLATFORM_QUALITY=85

# 判定扫描件的阈值：平均每页字符数低于该值即视为扫描件（需 OCR）。
# ⚠️ 它不是"本地引擎参数"——文本型/扫描件的分流规则与引擎无关，故保留。
SCANNED_CHAR_THRESHOLD=50

# ── 检索：Embedding 召回 + Reranker 精排 ──────────────────────
# 平台已部署 Qwen3-VL-Embedding-8B / Qwen3-VL-Reranker-8B，与对话、OCR **同一个网关、同一把 sk**
# （手册：Qwen3-VL-Embedding-Reranker调用手册.md）。默认复用上面的 LLM_*，无需重复填写。
#VEC_BASE_URL=http://10.254.208.35:8090/v1
#VEC_API_KEY=sk-q38-xxxxxxxx
VEC_TIMEOUT=300
# 模型名按平台实际暴露的名称填
VEC_EMBED_MODEL=Qwen3-VL-Embedding-8B
VEC_RERANK_MODEL=Qwen3-VL-Reranker-8B
# 输出维度（MRL 支持 64~4096）。取 1024：向量存储与余弦计算省 4 倍，本场景召回足够；
# 表格密集/编号相似的文档若召回明显不足，再调回 4096 做对比。
# 输出维度：0 = 不传该参数（用平台默认 4096 维）。
# ⚠️ 实测（2026-09-20）：本平台部署**不支持 MRL 降维**，传了会 HTTP 400
# （"does not support matryoshka representation"），故默认 0（4096 维）。
VEC_EMBED_DIMENSIONS=0
# 召回条数（送进 Reranker 的候选数）→ 精排后返回条数。手册建议 50~100 → 5~10。
RETRIEVAL_RECALL=50
RETRIEVAL_TOP_K=5
# 向量索引后端：local = 进程内余弦 + 本地向量缓存（当前默认，零部署，够用到几万条切片）；
#               opensearch = OpenSearch kNN（**正式选型**，部署好之后改成它即可，见 docs/知识库落地实施方案.md）
VEC_BACKEND=local
# 仅 VEC_BACKEND=opensearch 时需要
OPENSEARCH_URL=
OPENSEARCH_INDEX=pm-ai-chunks
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# ── 工作目录（OCR 中间产物、批次导出）────────────────────────
WORK_DIR=./work
