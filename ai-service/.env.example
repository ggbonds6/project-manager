# ============================================================
# AI 服务配置模板
# 复制为 .env 后按实际环境填写：cp .env.example .env
# .env 不入库（见 .gitignore），密钥只写在本机。
# ============================================================

# ── 服务自身 ─────────────────────────────────────────────────
AI_HOST=0.0.0.0
AI_PORT=8100

# ── 大模型（千问，OpenAI 兼容接口）──────────────────────────
# 只要推理服务暴露 /v1/chat/completions 即可（vLLM / Ollama / 一体机均可）
# 常见形态：
#   vLLM        http://<ip>:8000/v1
#   Ollama      http://<ip>:11434/v1
#   厂商一体机   按厂商文档（注意结尾是否带 /v1）
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=在此填入密钥
# 模型名按推理服务实际暴露的名称填（用 vLLM 时通常就是部署时的 --served-model-name）
LLM_MODEL=qwen
LLM_TIMEOUT=300

# 单次送给模型的最大字符数（中文约 1 字 ≈ 1 token）。超出会**按页截断**，
# 并在提示词里明确告知模型"你没看到全部"，避免它把残缺当全文。
LLM_MAX_INPUT_CHARS=20000

# 输出上限。⚠️ Qwen3 等推理模型的**思维链会消耗大量输出额度**：
# 设小了会出现 `completion_tokens` 撞上限、`content` 为空（模型只思考没给答案）。
# 实测踩过：8192 时 6 页合同分析返回空内容。建议 ≥ 16384。
LLM_MAX_TOKENS=16384

# 是否保留思维链。**默认 false** —— 实测（同一份 6 页扫描件合同）：
#   开启思考 → 思考 30584 字、耗尽 16384 token、最终答案为空，耗时 4 分 55 秒；
#   关闭思考 → 完整产出全部章节，来源标注与置信度分档均正常。
# 结论：高约束抽取任务上，思考模式不但慢，还会把最终答案挤掉。
# 只有确实需要深度推理的任务（如合规性判断）才建议开启，且要同步调大 LLM_MAX_TOKENS。
LLM_ENABLE_THINKING=false

# ── OCR ──────────────────────────────────────────────────────
# 渲染 DPI：300 是通用档；证件、小字可试 400；过高收益递减且更慢
OCR_DPI=300
# 判定扫描件的阈值：平均每页字符数低于该值即视为扫描件（需 OCR）
SCANNED_CHAR_THRESHOLD=50

# ── 工作目录（OCR 中间产物、批次导出）────────────────────────
WORK_DIR=./work
