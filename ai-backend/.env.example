# ─────────────────────────────────────────────────────────────
# AI 能力服务（Java 版）配置模板
# 复制为 .env 后按实际环境填写：cp .env.example .env
# .env 不入库（见 .gitignore），密钥只写在本机。
# 变量名与 Python 版保持一致，切换实现时无需改运维脚本。
# ─────────────────────────────────────────────────────────────

# ── 服务自身 ─────────────────────────────────────────────────
AI_HOST=0.0.0.0
AI_PORT=8100
WORK_DIR=/app/work

# ── 容器部署（服务器专用编排 ai/docker-compose.yml 读这几项）──────
# 镜像 tag：必须是 `docker load` 进来的 pm-ai-backend 标签；
#   ★出发布包时 make-release.ps1 会自动把它预填成本次版本，一般不用手改。
AI_IMAGE_TAG=latest
# 端口绑定地址：AI 服务【没有入站鉴权】，不要对全网裸开。
#   · 单机/内网隔离：填本机内网 IP（推荐），并用防火墙只放行主系统服务器；
#   · 0.0.0.0 仅适合完全隔离的内网环境；若 AI 与主系统同一台宿主机，也可用 127.0.0.1
#     （但那要求主系统的 AI_SERVICE_BASE_URL 用 host.docker.internal）。
AI_BIND_IP=0.0.0.0
# 文档库/切片/向量缓存落盘目录（容器内为 /app/work，映射到宿主机该路径）；
# 都是**可重建物**：丢了要重新解析，不影响正确性，但别放在临时目录里。
AI_WORK_DIR=./work

# ── 平台网关（对话 / OCR / 向量化 / 重排 **共用同一把 sk**）──
LLM_BASE_URL=http://10.254.208.35:8090/v1
LLM_API_KEY=sk-q38-xxxxxxxx
LLM_TIMEOUT=300

# ── 对话模型（千问，OpenAI 兼容）─────────────────────────────
LLM_MODEL=Qwen3.8-27B-W8A8
LLM_MAX_INPUT_CHARS=20000
LLM_MAX_TOKENS=16384
# 思维链默认关：实测开启后会吃光输出额度，最终 content 反而是空的
LLM_ENABLE_THINKING=false

# ── 平台 OCR（PaddleOCR-VL）──────────────────────────────────
# 没有本地兜底引擎（已移除）：平台不可用时**报错并要求人工复核**，不降级到差引擎。
OCR_MODEL=PaddleOCR-VL-1.6-0.9B
OCR_TIMEOUT=600
# 并发 12：实测同一份 6 页合同串行 1.84s/页 → 并发 12 得 2.45 页/秒（4.5 倍）
OCR_CONCURRENCY=12
# 每请求页数（平台建议 ≤16）
OCR_BATCH_PAGES=8
# 印章默认关：开启吞吐减半，且低 DPI 下会**编造**印章文字
OCR_SEAL=false
OCR_SEAL_MIN_PIXELS=400000
# 发给平台 OCR 的图：150 DPI JPEG（实测 120~300 DPI 结果一致，体积差 17 倍）
OCR_PLATFORM_DPI=150
OCR_PLATFORM_FORMAT=jpeg
OCR_PLATFORM_QUALITY=85
# 判定扫描件的阈值（平均每页字符数低于该值即视为扫描件）
SCANNED_CHAR_THRESHOLD=50

# ── 检索（Embedding 召回 + Reranker 精排）────────────────────
VEC_EMBED_MODEL=Qwen3-VL-Embedding-8B
VEC_RERANK_MODEL=Qwen3-VL-Reranker-8B
# 0 = 不传维度参数（平台默认 4096 维）。
# ⚠️ 实测本平台部署不支持 MRL 降维：传 dimensions 会 HTTP 400，故必须保持 0。
VEC_EMBED_DIMENSIONS=0
# 召回 50~100 → 精排 Top 5~10（手册建议）
RETRIEVAL_RECALL=50
RETRIEVAL_TOP_K=5
# local = 进程内余弦 + JSON 向量缓存（零部署）；opensearch = 正式选型（集群部署后切换）
VEC_BACKEND=local
OPENSEARCH_URL=
OPENSEARCH_INDEX=pm-ai-chunks
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
