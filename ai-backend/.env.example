# ─────────────────────────────────────────────────────────────
# AI 能力服务（Java 版）配置模板
# 复制为 .env 后按实际环境填写：cp .env.example .env
# .env 不入库（见 .gitignore），密钥只写在本机。
# 变量名与 Python 版保持一致，切换实现时无需改运维脚本。
# ─────────────────────────────────────────────────────────────

# ── 服务自身 ─────────────────────────────────────────────────
AI_HOST=0.0.0.0
AI_PORT=8100
WORK_DIR=/app/work

# ── 容器部署（服务器专用编排 ai/docker-compose.yml 读这几项）──────
# 镜像 tag：必须是 `docker load` 进来的 pm-ai-backend 标签；
#   ★出发布包时 make-release.ps1 会自动把它预填成本次版本，一般不用手改。
AI_IMAGE_TAG=latest
# 端口绑定地址：AI 服务【没有入站鉴权】，不要对全网裸开。
#   · 单机/内网隔离：填本机内网 IP（推荐），并用防火墙只放行主系统服务器；
#   · 0.0.0.0 仅适合完全隔离的内网环境；若 AI 与主系统同一台宿主机，也可用 127.0.0.1
#     （但那要求主系统的 AI_SERVICE_BASE_URL 用 host.docker.internal）。
AI_BIND_IP=0.0.0.0
# 文档库/切片/向量缓存落盘目录（容器内为 /app/work，映射到宿主机该路径）；
# 都是**可重建物**：丢了要重新解析，不影响正确性，但别放在临时目录里。
AI_WORK_DIR=./work

# ── 平台网关（对话 / OCR / 向量化 / 重排 **共用同一把 sk**）──
LLM_BASE_URL=http://10.254.208.35:8090/v1
LLM_API_KEY=sk-q38-xxxxxxxx
# ⚠️ 2026-10-10 起它只是**兜底值**：四类模型各有自己的超时（见下面「模型超时/并发/重试」），
#    对话走 LLM_CHAT_TIMEOUT=150，不再是 300。
LLM_TIMEOUT=300

# ── 对话模型（千问，OpenAI 兼容）─────────────────────────────
LLM_MODEL=Qwen3.8-27B-W8A8
LLM_MAX_INPUT_CHARS=20000
LLM_MAX_TOKENS=16384
# 思维链默认关：实测开启后会吃光输出额度，最终 content 反而是空的
LLM_ENABLE_THINKING=false

# ── 平台 OCR（PaddleOCR-VL）──────────────────────────────────
# 没有本地兜底引擎（已移除）：平台不可用时**报错并要求人工复核**，不降级到差引擎。
OCR_MODEL=PaddleOCR-VL-1.6-0.9B
OCR_TIMEOUT=600
# 并发 12：实测同一份 6 页合同串行 1.84s/页 → 并发 12 得 2.45 页/秒（4.5 倍）。
# ⚠️ 语义已修正：这是**全进程**的 OCR 在飞上限（共享一个线程池），
#    不再是"每份文档内 min(12, ceil(页数/8))"（那对 8 页文档是死配置，永远只有 1 个请求在飞）。
OCR_CONCURRENCY=12
# 单请求页数**上限**（平台建议 ≤16）；实际批页 = min(它, ceil(页数 / 在飞上限))，
# 页数少的文档会自动切成更小的批次，把并发真正用起来。
OCR_BATCH_PAGES=8
# 印章默认关：开启吞吐减半，且低 DPI 下会**编造**印章文字
OCR_SEAL=false
OCR_SEAL_MIN_PIXELS=400000
# 发给平台 OCR 的图：150 DPI JPEG（实测 120~300 DPI 结果一致，体积差 17 倍）
OCR_PLATFORM_DPI=150
OCR_PLATFORM_FORMAT=jpeg
OCR_PLATFORM_QUALITY=85
# 判定扫描件的阈值（平均每页字符数低于该值即视为扫描件）
SCANNED_CHAR_THRESHOLD=50

# ── 检索（Embedding 召回 + Reranker 精排）────────────────────
VEC_EMBED_MODEL=Qwen3-VL-Embedding-8B
VEC_RERANK_MODEL=Qwen3-VL-Reranker-8B
# 0 = 不传维度参数（平台默认 4096 维）。
# ⚠️ 实测本平台部署不支持 MRL 降维：传 dimensions 会 HTTP 400，故必须保持 0。
VEC_EMBED_DIMENSIONS=0
# 召回条数 = 送进 Reranker 的候选数（手册建议 50~100 → 精排 Top 5~10）。
# 耗时口径：每次检索 ≈ 1.5 × recall 对，一次问答 ≈ 2 次检索；平台重排实测 24 对/s
#   ⇒ recall=50 时 ≈ 6.3s/问，问答上限被压到 ≈0.16 QPS；
#   降到 20~25 可到 ≈0.4 QPS（约 2.5×），但会动答案质量。
# ⚠️ 默认保持 50；要降配用 RETRIEVAL_RECALL_MODE=low（见下），且**必须先评测**。
RETRIEVAL_RECALL=50
# baseline（默认，用 RETRIEVAL_RECALL）| low（用 RETRIEVAL_RECALL_LOW）| custom。
# ⚠️ 把默认改成 low/25 之前，必须用 eval/smoke-30.json 跑降配前后对比，
#    引用命中率与数字一致率都不下降才允许改（口径见 docs/AI模型调用与任务队列评估.md §6.1 P0-2）。
RETRIEVAL_RECALL_MODE=baseline
# RETRIEVAL_RECALL_MODE=low 时使用的召回条数（P0-2 建议区间 20~25）
RETRIEVAL_RECALL_LOW=25
RETRIEVAL_TOP_K=5

# ── 向量后端：local（进程内余弦 + JSON 缓存，零部署、可随时回滚）| opensearch（正式选型）──
VEC_BACKEND=local
# ⚠️ 必须指向**实际作为生产的那一台**：.110 与 .111 是两台**彼此独立的单节点集群**
#    （discovery.type: single-node，数据集不共享），**不要同时接业务**（否则同一个问题
#    在两个后端上召回不同、索引各自演化）。生产 = .110；.111 是冷备/演练机（收快照与归档）。
OPENSEARCH_URL=http://10.254.212.110:9200
OPENSEARCH_INDEX=pm-ai-chunks
OPENSEARCH_USER=admin
# 口令**只从环境变量/.env 读**，不要写进仓库、日志或工单；本文件留空。
OPENSEARCH_PASSWORD=
# 单次 REST 请求超时（秒）
OPENSEARCH_TIMEOUT=20
# _bulk 每批文档数
OPENSEARCH_BULK_SIZE=500
# hybrid（BM25 + kNN 两路融合）：默认 false。理由：BM25 与 cosinesimil 不同量纲（相加前必须各自归一），
# 本地已有一路关键词召回（2-gram + IDF），且"开与不开"的召回质量还没有评测基线。
OPENSEARCH_HYBRID=false

# ── 模型超时 / 并发 / 重试（P0-1、P0-5、P0-2）────────────────
# 硬约束：所有模型超时必须 < 调用方（主系统→AI 的 AI_CHAT_TIMEOUT=180s）预算；
# 违反的后果是"用户已超时、AI 侧槽位仍被占用"（P0-1 的根因）。
# 启动日志里会逐条核对并打印结论（见 StartupDiagnostics）。
LLM_CHAT_TIMEOUT=150
VEC_EMBED_TIMEOUT=30
VEC_RERANK_TIMEOUT=20
AI_CALLER_TIMEOUT=180
# 每模型在飞上限（信号量）：chat 4（平台 4 副本）/ embed 8（手册：批 32 + 并发 8 = 147.9 条/s）
# / rerank 2（单实例、峰值 24.8 对/s、问答链路单点）；OCR 用上面的 OCR_CONCURRENCY=12。
LLM_CHAT_CONCURRENCY=4
VEC_EMBED_CONCURRENCY=8
VEC_RERANK_CONCURRENCY=2
# 等 permit 的时长（毫秒）：交互式短（宁可 503"模型繁忙"也不排队到用户超时）；
# 批量（OCR / 重建索引的向量化）长（没人等，可以排）。
MODEL_ACQUIRE_TIMEOUT_MS=1500
MODEL_BATCH_ACQUIRE_TIMEOUT_MS=60000
# 只对**幂等**调用重试（OCR / embedding / 检索）；chat 永不重试。
# 退避 1s → 4s + 抖动 0~250ms；仅重试连接错误/超时/5xx/429。
MODEL_RETRY_MAX=2
MODEL_RETRY_BACKOFF_MS=1000
MODEL_RETRY_BACKOFF_MULTIPLIER=4
MODEL_RETRY_JITTER_MS=250

# ── 受控查询回调（P2）────────────────────────────────────────
# 回调地址与 scope_token 不在这里配：由主系统在每次 /chat 的 biz_query 里现给。
BIZ_QUERY_TIMEOUT=20

# ── L1 业务并发闸门（设计 §5）────────────────────────────────
# 与上面「模型超时/并发」的 L2 是**两层、单向**：先 L1 后 L2，且 L1 permit 全程持有。
# 三条防死锁硬规则：H1 顺序统一 / H2 排队不嵌套 / H3 优先级只在 L1（L2 恒为公平信号量）。
# 取值依据见 ai-backend/README.md 的「L1 业务并发闸门」表——改数字前先读那张表。
AI_GATE_ENABLED=true
# 交互式：并发 = 平台 4 个对话副本；**队列刻意是 0** ⇒ 1.5s 内拿不到就 503（不排队到 180s）
AI_GATE_INTERACTIVE_MAX=4
AI_GATE_INTERACTIVE_QUEUE=0
AI_GATE_INTERACTIVE_WAIT_MS=1500
# 批量解析：默认值与既有线程池（max 4 + 队列 100）逐字对齐 ⇒ 接入 L1 不改变既有行为
AI_GATE_BATCH_PARSE_MAX=4
AI_GATE_BATCH_PARSE_QUEUE=100
AI_GATE_BATCH_PARSE_PER_PROJECT_MAX=4
# 重建索引串行；批量向量化 4（不是 L2 的 8，理由见 README）；评测跑批 1
AI_GATE_BATCH_REINDEX_MAX=1
AI_GATE_BATCH_EMBED_MAX=4
AI_GATE_BATCH_EVAL_MAX=1
# 每项目在飞上限兜底（按 project_id 公平轮转）
AI_GATE_PER_PROJECT_MAX=4
# 软闸门：交互式有人等时暂停派发**新的** BATCH.PARSE（绝不踢掉在跑的批量）
AI_GATE_PAUSE_BATCH_WHEN_INTERACTIVE=true
# 老化（防饥饿）：每等满 30s 加 2 分、上限 40
AI_GATE_AGING_STEP_SECONDS=30
AI_GATE_AGING_BONUS_PER_STEP=2
AI_GATE_AGING_BONUS_MAX=40

# ── 阶段上报（设计 §4）───────────────────────────────────────
# AI 服务不直连库：阶段/产物/事件回调主系统 POST /api/ai/pipeline/**，
# 鉴权头 X-AI-Service-Token = AI_SERVICE_TOKEN
# ⚠️ 令牌**只从环境变量/.env 读**，不要写进仓库、日志、工单或截图；本文件留空。
# 上报失败不影响主流程（best-effort：只 WARN + 计数 ai.pipeline.report_failed）；只有终态会重试。
AI_PIPELINE_ENABLED=false
# 主系统基地址（AI 是回调方；与 LLM_BASE_URL=平台网关不是一回事）
AI_PIPELINE_BASE_URL=
AI_SERVICE_TOKEN=
# 单次上报超时（秒）：取小值，不能拖慢主流程
AI_PIPELINE_TIMEOUT=3
# 终态（/finish）的额外重试次数（终态丢失会让任务永远停在 RUNNING）
AI_PIPELINE_FINISH_RETRIES=2
# 领取租约与心跳（409 ⇒ 立即停止该任务并放回）
AI_PIPELINE_HEARTBEAT_SECONDS=30
AI_PIPELINE_LEASE_SECONDS=90
# 切片键形态：legacy = 三段（默认，与接入前逐字节一致）；rev = 带 clean_rev/chunk_rev 的五段
AI_PIPELINE_CHUNK_KEY_FORMAT=legacy
# 流水线版本：clean_rev=0 = **清洗关闭**（CLEAN 阶段如实上报 SKIPPED；切片输入 = 解析原文）
AI_PIPELINE_PARSE_REV=1
AI_PIPELINE_CLEAN_REV=0
AI_PIPELINE_CHUNK_REV=0

# ── 清洗阶段（设计 §3.3，G1/T7）───────────────────────────────
# 纯本地、确定性（同输入 + 同 clean_rev ⇒ 同输出）；规则只作用于文本层与平台 OCR markdown 两路。
# 产物：摘要进主系统 clean_diff（≤4000 字符）；全文留 work/clean/<docId>.json（可重建物）。
AI_CLEAN_ENABLED=false
# 启用的规则清单（c1~c8 见 README 的规则表；留空 = 用每条规则的默认开关 c1~c7）
AI_CLEAN_RULES=c1,c2,c3,c4,c5,c6,c7
# c1 跨页阈值与最小行长（页眉/页脚判定）
AI_CLEAN_HEADER_FOOTER_RATIO=0.5
AI_CLEAN_HEADER_FOOTER_MIN_CHARS=4
# c6 段级去重：false = 只标记不删（默认）；true = 真删重复段
AI_CLEAN_DEDUP_DROP=false
# c8 水印正则白名单（逗号分隔，默认空 ⇒ 该规则不生效）
AI_CLEAN_WATERMARK_PATTERNS=

# ── 切分（设计 §3.4，G11/G12）─────────────────────────────────
AI_CHUNK_IMPROVED=true
AI_CHUNK_CHARS=500
# 单切片硬上限：验收口径 = 不存在 > 该值的切片
AI_CHUNK_MAX_CHAR_LEN=2000
# 重叠比例（上限 0.15；按句回退、只在本页内）
AI_CHUNK_OVERLAP_RATIO=0.12
AI_CHUNK_STRUCTURE_AWARE=true
AI_CHUNK_TABLES_WHOLE=true
# 父块摘要字数上限（small-to-big 上卷；0 = 关闭）
AI_CHUNK_PARENT_SUMMARY_CHARS=200
